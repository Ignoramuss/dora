{
  "name": "codelens",
  "version": "0.1.0",
  "private": true,
  "description": "CodeLens — AI-powered codebase explorer",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace backend run build && npm --workspace frontend run build",
    "start": "npm --workspace backend run start",
    "test": "npm --workspace backend run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
